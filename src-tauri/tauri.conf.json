{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamForge",
  "version": "1.0.2",
  "identifier": "com.streamforge.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreamForge",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$VIDEO/**",
          "$DOCUMENT/**",
          "$DESKTOP/**",
          "$DOWNLOAD/**",
          "$APPDATA/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Record, edit and publish gaming videos to YouTube",
    "longDescription": "StreamForge records your gameplay with a facecam overlay, edits it on a multi-track timeline and publishes to YouTube with SEO-ready titles, tags and chapters.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    }
  }
}